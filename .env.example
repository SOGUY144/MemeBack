# Local SQLite database. The schema is Postgres-compatible — swap the provider
# in prisma/schema.prisma and point this at a Postgres URL to move.
DATABASE_URL="file:./dev.db"

# Optional. Without it the app still runs end to end: every answer falls back to
# FALLBACK_SCENE instead of a real storyboard.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# PORT=3000

# Optional. Used only by `npm run gen:backgrounds`, an offline script — never
# called from the request path. Renders one background per SETTING (see
# src/lib/meme/vocab.ts) and saves it to public/backgrounds/<setting>.{mp4,jpg}.
# The live renderer uses that file if present (decoding a looping .mp4 into a
# handful of cached frames once, at scene setup) and silently falls back to
# the built-in vector background (src/lib/meme/renderer.ts) if nothing was
# generated, so the app works with zero cost and zero setup by default.
#
# Two providers, pick one (the script defaults to whichever key is set,
# preferring Sora — pass --provider=kling|sora to force one):
#
# Sora (OpenAI) — short looping video per setting, played back as motion.
# OPENAI_API_KEY=
# SORA_MODEL=sora-2
#
# Kling — a single static image per setting, cheaper and instant to decode.
# KLING_API_KEY=
# KLING_API_BASE=https://api-singapore.klingai.com
# KLING_MODEL=kling-v1

# OPENAI_API_KEY also turns on one *live* feature, independent of the script
# above: src/server/meme-upgrade.ts upgrades exactly one meme per question —
# the one that opens CLASS_GUESS — from its sprite GIF to a real Sora video,
# generated on the spot when the teacher starts that round. Everyone still
# sees the sprite meme immediately; it's swapped for the AI video if and when
# that finishes (~30s-2min), never blocking the room. Deliberately not done
# for every student's answer — see the cost/latency math in that file. Unset
# = the feature no-ops and every meme stays sprite-only, same as before.

# The address the projector puts in the join QR. Leave it unset on a classroom
# LAN and the server advertises its own private IP, which is what phones on the
# same wifi need. Set it when serving through a tunnel or a real hostname —
# an https origin also lets phones use VideoEncoder, which produces a ~55KB mp4
# instead of the ~582KB gif.js fallback.
# PUBLIC_ORIGIN=https://memeback.example.com
