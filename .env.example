# Local SQLite database. The schema is Postgres-compatible — swap the provider
# in prisma/schema.prisma and point this at a Postgres URL to move.
DATABASE_URL="file:./dev.db"

# Optional. Without it the app still runs end to end: every answer falls back to
# FALLBACK_SCENE instead of a real storyboard.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# PORT=3000
